/*
 * BISTRO Pipeline Configuration
 * ==============================
 *
 * This file documents ALL parameters used by run_BISTRO.nf.
 * Copy this file and fill in dataset-specific paths before running.
 *
 * Usage:
 *     nextflow run run_BISTRO.nf -c nextflow.config
 */

workDir = '/storage/research/igmp_slide_workspace/GRP Zlobec/Carreno/External-datasets/nextflow_output/TMA1404/work/'
params {

    // ========================================================================
    // INPUT DATA
    // ========================================================================

    // Path to the QC'd SpatialData .zarr archive
    zarrFile            = '/storage/research/igmp_slide_workspace/GRP Zlobec/Carreno/CosMx-TMA-Singapore/dataset_formated_E/TMA1404_filtered.zarr'

    // Path to the scRNA-seq reference atlas (.rds or .RData) for InSituType
    scReferenceFile     = '/storage/research/igmp_slide_workspace/GRP Zlobec/Carreno/CosMx-TMA-Singapore/screference/LiuX_CRC_LiverMet_Reference_Profile.RData'

    // Tissue annotation file (.csv or .geojson) for batch effect modelling
    tissueAnnotation    = '/storage/research/igmp_slide_workspace/GRP Zlobec/Carreno/CosMx-TMA-Singapore/dataset_formated_E/TMA_core_tissue_annotation.csv'

    // FOVs (cores) are nested in patients: patient is the grouping factor and
    // FOV a variance component within it
    vc_column = 'patient'
    // Fixed effect for the batch-effect model: primary tumour, metastasis or
    // normal core, instead of the tissue annotation's anatomical origin
    fixed_effect_column = 'location'

    // H&E alignment affine matrix (3x3 CSV, no header). Leave empty if not used
    heAlignmentPath     = ''

    // Image pixel size in micrometers (used to scale GeoJSON polygons)
    pixelSize     = 0.12
    
    // ========================================================================
    // DATASET METADATA
    // ========================================================================

    // Human-readable dataset name (used in output filenames and report title)
    datasetName         = 'TMA1404'

    // iST platform: 'CosMx', 'Xenium', or 'MERSCOPE'
    technology          = 'CosMx'

    // ========================================================================
    // PLATFORM-SPECIFIC FLAGS
    // ========================================================================

    // Whether to run SpaNorm separately per FOV ('1' = yes, '0' = no)
    // Use '1' for large panels (WTx, 5000-plex) or TMA datasets
    separate_fovs       = '1'

    // Whether to use global coordinates for spatial plots ('1' = yes)
    add_global          = '1'

    // SKIP FLAGS (simulations have no scRNA-seq reference or tissue annotations)
    skip_annotation     = false
    skip_pathway        = false
    skip_hvg_bench      = true

    // Bootstrapping 
    n_boot_ci = 200

    // ========================================================================
    // OUTPUT DIRECTORIES
    // All paths are relative to output_folder_path
    // ========================================================================

    // Root output directory (all results are published here)
    output_folder_path  = '/storage/research/igmp_slide_workspace/GRP Zlobec/Carreno/External-datasets/nextflow_output/TMA1404/'

    // Subdirectories for each pipeline step
    outputNorm          = 'norm'
    outputPlots         = 'plots'
    outputTrans         = 'trans'
    outputHVG           = 'hvg'
    outputDims          = 'dims'
    outputAnno          = 'annotation'
    outputPathway       = 'pathway'
    temporary           = 'tmp'
    outputEval          = 'evaluation'

    // ========================================================================
    // COLORMAP / VISUALIZATION
    // ========================================================================

    // Path to a color list CSV for cell type coloring
    color_list          = '/storage/homefs/jc23k573/main/cosmx-tma-data/code/cosmx-metastasis-tma/color_list.csv'


    // ========================================================================
    // HVG BENCHMARK PARAMETERS (Section 2.4)
    // These control the HVG selection benchmarking step.
    // ========================================================================
    // HVG fractions to evaluate (used by both hvg_upset_plot and hvg_benchmark)
    hvg_fractions = '0.1 0.25 0.5 0.75 1.0'

    // Number of bootstrap iterations for clustering stability
    hvg_n_bootstrap     = 100

    // Fraction of cells subsampled per bootstrap iteration
    hvg_subsample_frac  = 0.80

    // Number of random gene sets to compare against HVG
    hvg_n_random_repeats = 5

    // Number of spatial nearest neighbors for coherence and graph
    hvg_k_neighbors     = 15

    // Leiden clustering resolution
    hvg_resolution      = 0.5

    // Random seed for reproducibility
    hvg_seed            = 42

    // HVG threshold used for annotation agreement analysis
    // (must match one of the fractions used in hvg_upset_plot: 0.1, 0.25, 0.5, 0.75, 1)
    hvgThreshold        = '0.75'
}


// ============================================================================
// PROCESS CONFIGURATION
// ============================================================================

process {
    // Added 2026-09-10. Without an executor Nextflow uses the LOCAL executor and
    // runs every task inside the driver's allocation, which is 1 cpu and 1 GB, so
    // any process requesting 2 cpus fails admission with "Process requirement
    // exceeds available CPUs". That is what killed cosmx-normalLiver-1k and
    // cosmx-normalPancreas-18k on 2026-09-10.
    executor       = 'slurm'
    queue          = 'cpu-invest'
    clusterOptions = '--nodes=1 --qos=job_cpu_preemptable --account=gratis'
    time           = '23h'

    errorStrategy = { task.exitStatus in [143, 137, 140, 151, 104, 134, 139] ? 'retry' : 'terminate' }
    maxRetries    = 5

    // Default resources
    cpus = 2
    memory = '256.GB'
    // maxForks = 3

    withName: 'scranNorm' {
        cpus = 6
        memory = '768.GB'
    }
    withName: 'spaNormLog' {
        cpus = 6
        memory = '768.GB'
    }
    withName: 'spaNormPearson' {
        cpus = 6
        memory = '768.GB'
    }

    withName: 'hvg_benchmark' {
        cpus = 2
        memory = '128.GB'
        // maxForks = 3
    }

    beforeScript = 'HPC_WORKSPACE=igmp_slide_workspace module load Workspace'
    
    withLabel: 'r_process' {
        beforeScript = '''
            HPC_WORKSPACE=igmp_slide_workspace module load Workspace
            HPC_WORKSPACE=igmp_dp_workspace module load Workspace
            module load GCCcore/12.3.0
            module load R/4.4.2-gfbf-2024a

            module load ICU/73.2-GCCcore-12.3.0

            module load libxml2/2.12.7-GCCcore-13.3.0
            module load GLib/2.80.4-GCCcore-13.3.0
            module load ImageMagick/7.1.1-15-GCCcore-12.3.0
            module load GLPK/5.0-GCCcore-10.3.0

            module load GDAL
            module load UDUNITS
            module load pkg-config
            module load libxml2/2.9.10-GCCcore-10.3.0 

            export MAKEFLAGS="-j$(nproc)"

            export CXX11STD="-std=gnu++14"
            export CXX14STD="-std=gnu++14"

            export R_LIBS_USER="/storage/research/igmp_dp_workspace/carreno_jose/R/x86_64-pc-linux-gnu-library/4.4"

            export R_INSTALL_STAGED=false
        '''
    }
    
    withLabel: 'python_process' {
        beforeScript = '''
            HPC_WORKSPACE=igmp_slide_workspace module load Workspace
            module load Anaconda3
            eval $(conda shell.bash hook)
            source activate py311
        '''
    }
}

executor {
    queueSize       = 25
    submitRateLimit = '15/1min'
    exitReadTimeout = '30 min'
}
