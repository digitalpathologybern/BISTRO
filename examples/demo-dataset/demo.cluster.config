/*
 * BISTRO demo -- UBELIX cluster overlay
 * =====================================
 *
 * Layered ON TOP OF demo.config, which stays deliberately portable (no
 * `module load`, no scheduler). This file adds only what the University of
 * Bern cluster needs: per-task environment module loading.
 *
 *     nextflow run run_BISTRO.nf \
 *         -c examples/demo-dataset/demo.config \
 *         -c examples/demo-dataset/demo.cluster.config
 *
 * Later -c files override earlier ones, so every params setting from
 * demo.config is preserved and only the process block is extended.
 *
 * The executor stays 'local': run_demo_slurm.sbatch submits ONE job and the
 * pipeline's tasks run inside it. That keeps the demo to a single scheduler
 * allocation rather than spawning ~40 tiny jobs.
 *
 * Each label loads its own environment, exactly as the manuscript configs do,
 * so the R and conda toolchains are never active in the same shell.
 *
 * The module versions below are copied from sample_configs/cosmx-crc-18k-11.config.
 * Adjust R_LIBS_USER if your R library lives elsewhere.
 */

process {

    withLabel: 'r_process' {
        beforeScript = '''
            HPC_WORKSPACE=igmp_slide_workspace module load Workspace
            HPC_WORKSPACE=igmp_dp_workspace module load Workspace
            module load GCCcore/12.3.0
            module load R/4.4.2-gfbf-2024a

            module load ICU/73.2-GCCcore-12.3.0

            module load libxml2/2.12.7-GCCcore-13.3.0
            module load GLib/2.80.4-GCCcore-13.3.0
            module load ImageMagick/7.1.1-15-GCCcore-12.3.0
            module load GLPK/5.0-GCCcore-10.3.0

            module load GDAL
            module load UDUNITS
            module load pkg-config
            module load libxml2/2.9.10-GCCcore-10.3.0

            export MAKEFLAGS="-j$(nproc)"

            export CXX11STD="-std=gnu++14"
            export CXX14STD="-std=gnu++14"

            export R_LIBS_USER="/storage/research/igmp_dp_workspace/carreno_jose/R/x86_64-pc-linux-gnu-library/4.4"

            export R_INSTALL_STAGED=false
        '''
    }

    withLabel: 'python_process' {
        beforeScript = '''
            HPC_WORKSPACE=igmp_slide_workspace module load Workspace
            module load Anaconda3
            eval $(conda shell.bash hook)
            source activate py311
        '''
    }
}
