/*
 * BISTRO demo configuration
 * =========================
 *
 * Runs the full pipeline on the simulated dataset produced by
 * make_demo_dataset.py, on a single machine, in minutes.
 *
 * Differences from the sample_configs/ used for the manuscript:
 *   - local executor, no SLURM and no `module load` (nothing here assumes
 *     the Bern cluster)
 *   - benchmark parameters cut hard (see HVG BENCHMARK below) so the demo
 *     finishes quickly; these are NOT the settings used for the paper
 *   - pathway analysis disabled (see TOGGLES)
 *   - restore_published = false, so the demo always recomputes
 *
 * Paths resolve from `projectDir` (the directory holding run_BISTRO.nf), so
 * this config works regardless of where you launch Nextflow from.
 *
 * Usage:
 *     bash examples/demo-dataset/run_demo.sh
 * or, once the inputs have been generated:
 *     nextflow run run_BISTRO.nf -c examples/demo-dataset/demo.config
 */

workDir = "${projectDir}/examples/demo-dataset/demo_output/work"

params {

    // ========================================================================
    // INPUT DATA  (all generated by make_demo_dataset.py + make_demo_reference.R)
    // ========================================================================

    zarrFile          = "${projectDir}/examples/demo-dataset/demo_filtered.zarr"
    scReferenceFile   = "${projectDir}/examples/demo-dataset/demo_reference.RData"
    tissueAnnotation  = "${projectDir}/examples/demo-dataset/demo_tissue_annotations.csv"

    // Not used by the demo: the tissue annotation is a CSV, not a GeoJSON,
    // so no H&E affine or pixel size is required.
    heAlignmentPath   = ''
    pixelSize         = 0.12

    // ========================================================================
    // DATASET METADATA
    // ========================================================================

    datasetName       = 'BISTRO-Demo'

    // The simulated data carries native FOV identifiers on a 3 x 3 grid of
    // 510.72 um tiles, i.e. the CosMx convention. assignFOV therefore takes
    // the native-FOV path and does not rasterize.
    technology        = 'CosMx'

    // ========================================================================
    // PLATFORM-SPECIFIC FLAGS
    // ========================================================================

    // Global SpaNorm rather than per-FOV. The demo has ~222 cells per FOV,
    // below the 300-cell threshold at which spanorm.R merges FOVs to keep
    // spline fitting stable, so per-FOV mode would collapse them all into one
    // group anyway. Global is equivalent here and faster.
    separate_fovs     = '0'
    add_global        = '1'

    // ========================================================================
    // OUTPUT
    // ========================================================================

    output_folder_path = "${projectDir}/examples/demo-dataset/demo_output/"

    outputNorm        = 'norm'
    outputPlots       = 'plots'
    outputTrans       = 'trans'
    outputHVG         = 'hvg'
    outputDims        = 'dims'
    outputAnno        = 'annotation'
    outputPathway     = 'pathway'
    temporary         = 'tmp'
    outputEval        = 'evaluation'

    color_list        = "${projectDir}/examples/demo-dataset/demo_color_list.txt"

    // ========================================================================
    // HVG BENCHMARK  -- REDUCED FOR SPEED, not the manuscript settings
    // ========================================================================
    // Manuscript values, for reference:
    //   hvg_fractions '0.1 0.25 0.5 0.75 1.0', hvg_n_bootstrap 100,
    //   hvg_n_random_repeats 5, n_boot_ci 200
    //
    // 1.0 must stay in hvg_fractions: the HVG benchmark's reference labels are
    // the InSituType calls at 100% HVG on the `none` normalization.
    hvg_fractions        = '0.25 1.0'
    hvg_n_bootstrap      = 10
    hvg_subsample_frac   = 0.80
    hvg_n_random_repeats = 2
    hvg_k_neighbors      = 15
    hvg_resolution       = 0.5
    hvg_seed             = 42

    // Must be one of the values in hvg_fractions above.
    hvgThreshold         = '0.25'

    // Bootstrap replicates for the tau^2 confidence interval.
    n_boot_ci            = 20

    // ========================================================================
    // TOGGLES
    // ========================================================================

    skip_annotation   = false
    skip_hvg_bench    = false

    // Pathway analysis is disabled for the demo. bin/plotters/pathway_analysis_HVG.R
    // needs GOfuncR and msigdbr, and the pathway_analysis_hvg process issues a
    // `module load CMake` that only exists on an HPC with environment modules.
    // Neither is available in a plain conda + R install.
    skip_pathway      = true

    // Always recompute, so the demo exercises every process rather than
    // symlinking earlier results.
    restore_published = false
}


// ============================================================================
// PROCESS CONFIGURATION
// ============================================================================
// No executor, queue, clusterOptions or beforeScript: everything runs locally
// in whatever conda / R environment is already active. Resources are sized for
// 2000 cells x 200 genes and fit comfortably on a laptop.

process {
    executor = 'local'
    cpus     = 2
    memory   = '4.GB'

    withName: 'hvg_benchmark' {
        cpus = 2
    }
}
